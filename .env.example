# ==========================================
# PROSPECT PULSE V1 - PRODUCTION ENVIRONMENT
# ==========================================

# Core Django Security (Mandatory in Production)
DJANGO_DEBUG="False"
SECRET_KEY="generate-a-strong-50-char-random-secret-key-here"

# Domain & Host Headers (Comma-separated)
ALLOWED_HOSTS="console.agentyne.com,console-stage.agentyne.com,127.0.0.1,localhost"
CSRF_TRUSTED_ORIGINS="https://console.agentyne.com,https://console-stage.agentyne.com"

# Google Gemini LLM API (Mandatory for ICP Extraction & Relevance Evaluation)
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Redis & Celery Message Broker (Mandatory for Async Crawling Pipeline)
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# B2B Lead Intelligence & Enrichment APIs (Optional / Integrations)
DISBURSE_API_KEY=""
LEAD_ENRICHMENT_API_URL=""
LEAD_ENRICHMENT_API_KEY=""
